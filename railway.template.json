{
  "$schema": "https://railway.com/railway.schema.json",
  "services": {
    "api": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "coredent-api/Dockerfile"
      },
      "deploy": {
        "startCommand": "python /app/start.py",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "networking": {
        "ports": [3000]
      },
      "variables": {
        "PROCESS_TYPE": "web",
        "PORT": "3000"
      }
    },
    "worker": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "coredent-api/Dockerfile"
      },
      "deploy": {
        "startCommand": "python /app/start.py",
        "restartPolicyType": "ALWAYS"
      },
      "variables": {
        "PROCESS_TYPE": "worker",
        "CELERY_QUEUES": "default,communications,reminders,emails"
      }
    },
    "beat": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "coredent-api/Dockerfile"
      },
      "deploy": {
        "startCommand": "python /app/start.py",
        "restartPolicyType": "ALWAYS"
      },
      "variables": {
        "PROCESS_TYPE": "beat",
        "RUN_MIGRATIONS_ON_START": "false"
      }
    }
  }
}
