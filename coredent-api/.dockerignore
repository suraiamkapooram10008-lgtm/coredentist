# Environment
# Never bake env files into image layers. The plain ".env" pattern did not
# cover ".env.staging", ".env.production", or the git-tracked
# ".env.staging.railway", and "COPY . ." picked all of them up.
.env
.env.*

# Alembic (keep only necessary files)
alembic/__pycache__/
alembic/versions/__pycache__/
