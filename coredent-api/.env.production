# CoreDent API - Production Environment Variables
# IMPORTANT: Fill in all values before deploying to production

# ==============================================
# Application
# ==============================================
APP_NAME=CoreDent API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# ==============================================
# Database - REQUIRED
# ==============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://coredent_user:CHANGE_THIS_PASSWORD@your-db-host:5432/coredent_production
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ==============================================
# Security - REQUIRED (CRITICAL - FIXED IN CRIT-04)
# ==============================================
# GENERATE SECRETS BEFORE PRODUCTION:
# SECRET_KEY:       python -c "import secrets; print(secrets.token_urlsafe(32))"
# ENCRYPTION_KEY:   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 
# ⚠️  WARNING: Application will FAIL TO START if these are not set!
# ⚠️  For production, use AWS Secrets Manager, HashiCorp Vault, or similar
SECRET_KEY=<YOUR_SECRET_KEY_HERE>
ENCRYPTION_KEY=<YOUR_ENCRYPTION_KEY_HERE>

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session and Password Configuration
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
SESSION_TIMEOUT_MINUTES=30

# ==============================================
# CORS - REQUIRED (REPLACE with your actual domains)
# ==============================================
# Comma separated list of allowed origins (NO wildcards, NO localhost in production)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==============================================
# Allowed Hosts - REQUIRED
# ==============================================
# Comma separated list of allowed hosts (NO WILDCARDS)
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com

# ==============================================
# Frontend URL - REQUIRED
# ==============================================
FRONTEND_URL=https://yourdomain.com

# ==============================================
# Rate Limiting
# ==============================================
RATE_LIMIT_PER_MINUTE=100

# ==============================================
# Email Configuration - REQUIRED for production
# ==============================================
# NOTE: For production, use AWS Secrets Manager or similar for credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=<YOUR_SMTP_PASSWORD>  # Use app-specific password for Gmail
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=CoreDent PMS
SMTP_USE_TLS=true

# ==============================================
# AWS S3 Configuration - REQUIRED for file storage
# ==============================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=coredent-production-files
AWS_REGION=us-east-1

# ==============================================
# Encryption - REQUIRED
# ==============================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_THIS_TO_A_FERNET_KEY

# ==============================================
# Redis Configuration - OPTIONAL
# ==============================================
REDIS_URL=redis://your-redis-host:6379/0
REDIS_CACHE_TTL=3600

# ==============================================
# Sentry - REQUIRED for error tracking
# ==============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==============================================
# File Upload
# ==============================================
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx

# ==============================================
# Pagination
# ==============================================
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ==============================================
# HIPAA Compliance
# ==============================================
AUDIT_LOG_ENABLED=True
SESSION_TIMEOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_EXPIRE_DAYS=90

# ==============================================
# SECURITY NOTES
# ==============================================
# - Never commit this file to version control
# - Use secrets management service (AWS Secrets Manager, HashiCorp Vault)
# - Rotate keys regularly (every 90 days minimum)
# - Use strong, unique passwords for all services
# - Enable SSL/TLS for all connections
# - Restrict database access to application servers only
