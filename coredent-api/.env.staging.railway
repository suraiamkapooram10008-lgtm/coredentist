# ============================================================
# CoreDent API - STAGING Environment (Railway-ready)
# Paste into Railway -> Variables (NEWLINE-separated). Keep
# staging values separate from prod; never share secrets.
# ============================================================

# --- Application ---
APP_NAME=CoreDent API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=staging
PORT=3000
# Celery role per service (start.py): api=web | worker | beat | release
PROCESS_TYPE=web
# API: migrations on boot (default true). worker/beat: false.
RUN_MIGRATIONS_ON_START=true

# --- Database (Railway references) ---
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Security (generated, staging) ---
SECRET_KEY=apVPkzjjlZA6IypUIwNLATs2s7FTWNLzGSdTa9nX_vPdQXP8V6AOQQNT9dcXVt7X
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEYS=current:hEkqogWVLfOt6RX9-aw0jYYWgGn-_qfA2-UFTz8UWfs=
# Legacy alias; leave unset when ENCRYPTION_KEYS is present.
#ENCRYPTION_KEY=
SEARCH_INDEX_KEY=V5U4FJHl7Q1JThOMnPRfTg1Eh57P5bEJB33gWJmVaezpyduihYgG5t2SsJcRjkJK
KMS_BACKEND=env
#AWS_KMS_KEY_ARN=

# --- CORS / Hosts / Proxy (replace with your real domains) ---
CORS_ORIGINS=https://app.example.com
ALLOWED_HOSTS=api.example.com,healthcheck.railway.app
FRONTEND_URL=https://app.example.com
# Railway edge CIDR. "0.0.0.0/0" is a valid ip_network but broad; the config
# gate accepts it as a valid entry, but production should narrow it to the
# actual Railway ingress ranges (see Railway docs → networking).
TRUSTED_PROXIES=0.0.0.0/0

# --- Email (test mailbox; must not be localhost/placeholder) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=CoreDent PMS

# --- Object storage (MUST be a private bucket) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# --- Redis / Celery (Railway references) ---
REDIS_URL=${{Redis.REDIS_URL}}
CELERY_BROKER_URL=${{Redis.REDIS_URL}}
CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}

# --- Stripe (TEST keys only in staging) ---
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# --- Razorpay (optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Monitoring ---
# 32+ chars; open endpoint /metrics is blocked without this.
MONITORING_TOKEN=Z2YcVv5kokuZuaIFUbbWHeRbWgG6I7T9PKAXwOFIOa0lm7sVmgiuHla6bXT4aCv0
SENTRY_DSN=

# --- Upload / pagination ---
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# --- HIPAA / auth policy (unchanged from prod defaults) ---
AUDIT_LOG_ENABLED=True
SESSION_TIMEOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True

# --- Twilio (test credentials; optional if SMS not used) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Retention (defaults shown; override per practice via UI) ---
RETENTION_ANONYMIZED_PURGE_YEARS=7
RETENTION_ANONYMIZED_PURGE_BATCH_SIZE=50
RETENTION_ANONYMIZED_PURGE_ENABLED=true