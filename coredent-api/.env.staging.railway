# ============================================================
# CoreDent API - STAGING Environment (Railway-ready)
# Paste into Railway -> Variables (NEWLINE-separated). Keep
# staging values separate from prod; never share secrets.
# ============================================================
# This file is TRACKED BY GIT - it must NEVER contain real secrets.
# The secret fields below are intentionally blank. Generate them and paste
# the values into Railway's Variables (Raw Editor) ONLY - never back into
# this file. This template will NOT boot as-is; the config gate refuses to
# start until every required value is filled (see
# docs/PRODUCTION_REQUIRED_ENV.md).
# ============================================================

# --- Application ---
APP_NAME=CoreDent API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=staging
PORT=3000
# Celery role per service (start.py): api=web | worker | beat | release
PROCESS_TYPE=web
# API: migrations on boot (default true). worker/beat: false.
RUN_MIGRATIONS_ON_START=true

# --- Database (Railway references) ---
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Connection budget is PER REPLICA and the pool is shared by api + worker +
# beat (pool + overflow each). 3 replicas at 5+5 = 30 connections, which fits
# a small Railway Postgres. Raise only if max_connections allows it.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# --- Security (generated, staging) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Generate: python -c "from cryptography.fernet import Fernet; print('current:'+Fernet.generate_key().decode())"
ENCRYPTION_KEYS=
# Legacy alias; leave unset when ENCRYPTION_KEYS is present.
#ENCRYPTION_KEY=
# Must be an INDEPENDENT secret, never derived from ENCRYPTION_KEYS:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SEARCH_INDEX_KEY=
KMS_BACKEND=env
#AWS_KMS_KEY_ARN=

# --- CORS / Hosts / Proxy ---
# Confirmed staging frontend origin (Vercel). Must stay byte-identical to the
# deployed frontend origin or the browser blocks every API call.
CORS_ORIGINS=https://coredentist-lohh.vercel.app
# CONFIRM: set this to THIS staging service's own Railway domain
# (Settings -> Networking -> Public Domain). Pointing staging at the
# production hostname makes TrustedHostMiddleware reject every request with
# "Invalid host header". The *.up.railway.app wildcard keeps the first
# deploy unblocked; pin the exact host once you know it.
ALLOWED_HOSTS=*.up.railway.app,healthcheck.railway.app
FRONTEND_URL=https://coredentist-lohh.vercel.app
# Railway edge CIDR. "0.0.0.0/0" is a valid ip_network but broad; the config
# gate accepts it as a valid entry, but production should narrow it to the
# actual Railway ingress ranges (see Railway docs -> networking).
TRUSTED_PROXIES=0.0.0.0/0

# --- Email ---
# Mailtrap SANDBOX never delivers to real inboxes - it only populates the
# Mailtrap web UI. That is correct for staging, but it means you cannot
# end-to-end test "user receives the reset email".
# REQUIRED by the boot gate: SMTP_USER and SMTP_PASSWORD must be real.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@coredent.com
SMTP_FROM_NAME=CoreDent Staging
# CRITICAL: the default is "console" for ANY environment != production, so
# without this line staging boots green and then silently prints every
# password-reset / verification / reminder email to the logs instead of
# sending it. Set it explicitly.
EMAIL_PROVIDER=smtp
# Staging has no Twilio number; console keeps SMS paths exercised without
# spending money. Switch to "twilio" and fill TWILIO_* to test real SMS.
SMS_PROVIDER=console

# --- Object storage (MUST be a private bucket that already exists) ---
# REQUIRED by the boot gate: AWS_S3_BUCKET must be a real, non-placeholder
# name. Keys are not gate-checked, so an empty key pair boots and then fails
# on the first upload.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=coredent-staging-bucket
AWS_REGION=us-east-1

# --- Antivirus (optional; uploads are NOT scanned without it) ---
# Unset -> ClamAV init fails -> the scanner falls through to VirusTotal ->
# which is also unconfigured -> and that path FAILS OPEN. Uploads succeed
# unscanned. Add the Railway ClamAV template and point this at its private
# domain to actually scan patient documents.
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Redis / Celery (Railway references) ---
REDIS_URL=${{Redis.REDIS_URL}}
CELERY_BROKER_URL=${{Redis.REDIS_URL}}
CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}

# --- Stripe (TEST keys only in staging) ---
# STRIPE_WEBHOOK_SECRET is REQUIRED by the boot gate and rejects placeholders:
# the app will not start until you have created the Stripe test-mode webhook
# endpoint and pasted the real whsec_ value.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Razorpay (optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Monitoring ---
# 32+ chars; open endpoint /metrics is blocked without this.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
MONITORING_TOKEN=
# REQUIRED by the boot gate - the app refuses to start without a Sentry DSN.
# Get it from the Sentry project dashboard (Settings -> Client Keys -> DSN).
SENTRY_DSN=

# --- Upload / pagination ---
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# --- HIPAA / auth policy (unchanged from prod defaults) ---
AUDIT_LOG_ENABLED=True
SESSION_TIMEOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True

# --- Twilio (test credentials; only needed when SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Retention (defaults shown; override per practice via UI) ---
RETENTION_ANONYMIZED_PURGE_YEARS=7
RETENTION_ANONYMIZED_PURGE_BATCH_SIZE=50
RETENTION_ANONYMIZED_PURGE_ENABLED=true
