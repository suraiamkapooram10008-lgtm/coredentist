# =============================================================================
# CoreDent API - Environment Configuration Template
# =============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to `.env` for local development
# 2. Fill in ALL values marked with CHANGE_ME / YOUR_*
# 3. For production, use `.env.production` with actual production values
# 4. NEVER commit the actual `.env` or `.env.production` files to version control
# 5. Use a secrets manager (AWS Secrets Manager, HashiCorp Vault) for production
# =============================================================================

# ==============================================
# Application
# ==============================================
APP_NAME=CoreDent API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# ==============================================
# Database - CHANGE ME
# ==============================================
# For development SQLite is used by default (no config needed)
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=

# ==============================================
# Security - CHANGE ME (REQUIRED FOR PRODUCTION)
# ==============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================
# CORS - CHANGE ME (REQUIRED FOR PRODUCTION)
# ==============================================
# Comma-separated list of allowed origins
# Production: https://your-frontend-domain.com (NO localhost, NO wildcards)
CORS_ORIGINS=

# ==============================================
# Allowed Hosts - CHANGE ME (REQUIRED FOR PRODUCTION)
# ==============================================
# Comma-separated list of allowed hosts
# Production: your-api-domain.com (NO localhost, NO wildcards)
ALLOWED_HOSTS=

# ==============================================
# Frontend URL - CHANGE ME (REQUIRED FOR PRODUCTION)
# ==============================================
FRONTEND_URL=

# ==============================================
# Rate Limiting
# ==============================================
RATE_LIMIT_PER_MINUTE=100

# ==============================================
# Email Configuration - CHANGE ME (REQUIRED FOR PRODUCTION)
# ==============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# ==============================================
# AWS S3 Configuration (Optional)
# ==============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ==============================================
# Encryption - CHANGE ME (REQUIRED FOR PRODUCTION)
# ==============================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ==============================================
# Redis Configuration (Optional)
# ==============================================
REDIS_URL=
REDIS_CACHE_TTL=3600

# ==============================================
# Sentry (Optional - Recommended for Production)
# ==============================================
SENTRY_DSN=

# ==============================================
# CAPTCHA Configuration (Required for Online Booking)
# ==============================================
# Get keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
HCAPTCHA_SITE_KEY=

# ==============================================
# Payment Processing (Optional)
# ==============================================
# Stripe (US Market)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay (Indian Market)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==============================================
# Insurance EDI (Optional)
# ==============================================
DXC_API_KEY=
DXC_API_SECRET=
DXC_BASE_URL=https://api.dentalxchange.com/v2

# ==============================================
# QuickBooks Integration (Optional)
# ==============================================
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=
QB_ENVIRONMENT=sandbox

# ==============================================
# Webhook Security (Recommended for Production)
# ==============================================
STRIPE_WEBHOOK_IP_WHITELIST_ENABLED=true
STRIPE_WEBHOOK_HMAC_SECRET=

# ==============================================
# File Upload
# ==============================================
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx

# ==============================================
# Pagination
# ==============================================
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ==============================================
# HIPAA Compliance
# ==============================================
AUDIT_LOG_ENABLED=True
SESSION_TIMEOUT_MINUTES=30
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_EXPIRE_DAYS=90

# ==============================================
# OAuth / Social Login (Optional)
# ==============================================
GOOGLE_OAUTH_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ==============================================
# Monitoring
# ==============================================
MONITORING_TOKEN=

# =============================================================================
# IMPORTANT SECURITY NOTES
# =============================================================================
# 1. NEVER commit this file with actual values filled in
# 2. Rotate secrets every 90 days minimum
# 3. Use different values for dev/staging/production environments
# 4. Enable MFA for all production database access
# 5. Use a secrets manager in production (not .env files)
# 6. All PHI/ePHI data must be encrypted at rest and in transit
# 7. Regular security audits are required for HIPAA compliance
# =============================================================================