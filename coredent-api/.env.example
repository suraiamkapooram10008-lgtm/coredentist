# ============================================================================
# CoreDent API - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in ALL values before running the application.
# For production: cp .env.example .env && nano .env
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
APP_NAME=CoreDent API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development  # development | production

# ----------------------------------------------------------------------------
# DATABASE (REQUIRED)
# ----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ----------------------------------------------------------------------------
# SECURITY - CRITICAL (REQUIRED IN PRODUCTION)
# ----------------------------------------------------------------------------
# JWT signing key - MUST be at least 32 characters, cryptographically random
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Or: openssl rand -base64 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON_C_IMPORT_SECRETS_PRINT_SECRETS_TOKEN_URLSAFE_32

# JWT algorithm (DO NOT CHANGE unless you know what you're doing)
ALGORITHM=HS256

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Field-level encryption for PHI (Protected Health Information)
# REQUIRED IN PRODUCTION - encrypts patient names, SSNs, medical data at rest
# Format: Comma-separated list of key_id:fernet_key pairs
# Generate key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Example: current:ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
# For rotation: current:NEW_KEY,previous:OLD_KEY
ENCRYPTION_KEYS=CHANGE_ME_GENERATE_WITH_FERNET_GENERATE_KEY

# HMAC key for patient search indexes. Required at boot outside local
# environments; must be an INDEPENDENT secret (not derived from the Fernet
# key), at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SEARCH_INDEX_KEY=

# KMS backend for managing the ENCRYPTION_KEYS data key: env | aws | local.
# When 'aws', AWS_KMS_KEY_ARN must also be set (validated at boot).
KMS_BACKEND=env
AWS_KMS_KEY_ARN=

# Monitoring endpoint authentication token
# Required to access /metrics endpoint in production
# Generate with: openssl rand -hex 16 (at least 32 characters)
MONITORING_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_16

# Trusted reverse proxies for X-Forwarded-For and rate limiting
# Required in production; use comma-separated IPs/CIDR ranges, never '*'.
# Example: 10.0.0.0/8,192.0.2.10
TRUSTED_PROXIES=*

# ----------------------------------------------------------------------------
# NETWORK SECURITY (REQUIRED IN PRODUCTION)
# ----------------------------------------------------------------------------
# CORS - Comma-separated list of allowed origins
# Production: Only your frontend domain(s)
# Development: http://localhost:8080,http://localhost:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# Allowed hosts - Comma-separated list, NO WILDCARDS
# Production: api.yourdomain.com,www.yourdomain.com
# Development: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend URL - Used for password reset links, email verification
# Production: https://app.yourdomain.com
FRONTEND_URL=http://localhost:8080

# Rate limiting
RATE_LIMIT_PER_MINUTE=100

# ----------------------------------------------------------------------------
# EMAIL (REQUIRED FOR PASSWORD RESETS)
# ----------------------------------------------------------------------------
# SMTP configuration for sending emails
# Examples: Gmail, SendGrid, AWS SES, Mailgun
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL@gmail.com
SMTP_PASSWORD=YOUR_APP_PASSWORD  # For Gmail: use App Password, not account password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=CoreDent PMS

# ----------------------------------------------------------------------------
# FILE STORAGE - AWS S3 (REQUIRED IN PRODUCTION)
# ----------------------------------------------------------------------------
# AWS credentials for S3 file storage (patient documents, images)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_S3_BUCKET=YOUR_S3_BUCKET_NAME
AWS_REGION=us-east-1

# ----------------------------------------------------------------------------
# CACHING - REDIS (REQUIRED IN PRODUCTION)
# ----------------------------------------------------------------------------
# Redis connection string for caching and rate limiting
# Format: redis://host:port/db or rediss:// for TLS
# Production: rediss://redis.example.com:6379/0
# Development: redis://localhost:6379/0
REDIS_URL=redis://YOUR_REDIS_HOST:6379/0
REDIS_CACHE_TTL=3600

# ----------------------------------------------------------------------------
# MONITORING - SENTRY (REQUIRED IN PRODUCTION)
# ----------------------------------------------------------------------------
# Sentry DSN for error tracking and performance monitoring
# Get from: https://sentry.io/settings/projects/
SENTRY_DSN=  # REQUIRED IN PRODUCTION - application will refuse to start if empty

# ----------------------------------------------------------------------------
# PAYMENTS - STRIPE (REQUIRED IF USING STRIPE)
# ----------------------------------------------------------------------------
# Stripe API keys
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...  # Use sk_live_... in production
STRIPE_PUBLISHABLE_KEY=pk_test_...  # Use pk_live_... in production

# Stripe webhook signing secret
# Get from: https://dashboard.stripe.com/webhooks
# Format: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_...  # REQUIRED IF USING STRIPE

# Webhook security
STRIPE_WEBHOOK_IP_WHITELIST_ENABLED=true

# ----------------------------------------------------------------------------
# CAPTCHA (REQUIRED FOR ONLINE BOOKING)
# ----------------------------------------------------------------------------
# Google reCAPTCHA v2
# Get from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=

# hCaptcha (alternative to reCAPTCHA)
# Get from: https://www.hcaptcha.com/
HCAPTCHA_SECRET_KEY=
HCAPTCHA_SITE_KEY=

# ----------------------------------------------------------------------------
# FILE UPLOAD LIMITS
# ----------------------------------------------------------------------------
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ----------------------------------------------------------------------------
# PAGINATION
# ----------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ----------------------------------------------------------------------------
# HIPAA COMPLIANCE
# ----------------------------------------------------------------------------
AUDIT_LOG_ENABLED=True
SESSION_TIMEOUT_MINUTES=30
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_EXPIRE_DAYS=90

# ----------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# ----------------------------------------------------------------------------
# DentalXChange (insurance EDI)
DXC_API_KEY=
DXC_API_SECRET=
DXC_BASE_URL=https://api.dentalxchange.com/v2

# QuickBooks integration
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=
QB_ENVIRONMENT=sandbox  # sandbox | production

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
# Before deploying to production, verify:
# 1. ENVIRONMENT=production
# 2. DEBUG=False
# 3. SECRET_KEY is at least 32 characters and cryptographically random
# 4. ENCRYPTION_KEYS contains valid Fernet key(s)
# 5. SENTRY_DSN is set
# 6. REDIS_URL uses rediss:// (TLS)
# 7. CORS_ORIGINS contains only production domains
# 8. ALLOWED_HOSTS contains only production domains
# 9. STRIPE_WEBHOOK_SECRET is set (if using Stripe)
# 10. Database uses strong credentials (not default postgres/postgres)
# 11. All .env files are in .gitignore
# 12. Run: python -c "from app.core.config import validate_production; validate_production()"
# ============================================================================
