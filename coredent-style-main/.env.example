# CoreDent PMS - Environment Variables
# Copy this file to .env and fill in your values

# ==============================================
# API Configuration
# ==============================================

# Backend API URL
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ==============================================
# Feature Flags
# ==============================================

# Enable demo mode with mock data (development only)
VITE_ENABLE_DEMO_MODE=true

# Enable development mode authentication bypass
VITE_DEV_BYPASS_AUTH=false

# ==============================================
# Analytics (M-7 FIX: PostHog keys removed — no PostHog client in src/;
# re-add only with a wired implementation)
# ==============================================

# Enable analytics tracking (wired: src/services/analytics.ts)
VITE_ANALYTICS_ENABLED=false

# Analytics endpoint (wired: src/services/monitoring.ts)
# VITE_ANALYTICS_ENDPOINT=

# ==============================================
# Error Monitoring
# ==============================================

# Sentry DSN for error tracking (wired: src/lib/logger.ts)
VITE_SENTRY_DSN=

# NOTE: VITE_SENTRY_ENVIRONMENT is intentionally absent — no code reads it.

# ==============================================
# Payment Processing (M-7 FIX: Stripe/Square/OAuth/push/email/SMS/MFA keys
# removed — no code reads VITE_STRIPE_PUBLISHABLE_KEY,
# VITE_SQUARE_APPLICATION_ID/LOCATION_ID, VITE_GOOGLE/APPLE_CLIENT_ID,
# VITE_ENABLE_PUSH/EMAIL/SMS_NOTIFICATIONS, VITE_ENABLE_MFA, VITE_DEBUG,
# VITE_ENABLE_DEVTOOLS, VITE_SUPABASE_* in src/. Re-add only with a wired
# implementation; online payments are fail-closed server-side regardless.)
# ==============================================

# ==============================================
# Development
# ==============================================

# reCAPTCHA site key (wired: src/lib/recaptcha.ts)
# VITE_RECAPTCHA_SITE_KEY=

# ==============================================
# Production
# ==============================================

# Production API URL (override in production)
# VITE_API_BASE_URL=https://api.coredent.com/api/v1

# Production Sentry DSN
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Production Analytics
# VITE_ANALYTICS_ENABLED=true
# VITE_POSTHOG_KEY=your-posthog-key

# ==============================================
# Notes
# ==============================================

# - All VITE_ prefixed variables are exposed to the client
# - Never commit .env file to version control
# - Use .env.local for local overrides
# - Use .env.production for production values
# - Restart dev server after changing environment variables
